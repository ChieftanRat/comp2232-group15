@ ******************  Muhammad 1: Vehicles *******************
@ - The repair cost for each type and model.
@ - The cost of parts for each type and model.
@ - The minimum time to repair for each type and model.

@change the name so it wouldnt get confused with the original vehicle class

class VehicleRepairDetails
! Contains repair cost, parts cost, and minimum repair time information for different vehicle types and models. !
services 

	repairCost
	! Returns the the calculated cost of repairing the giving vehicle. ! ;

	partCost
	! returns the cost of parts for each type and model. ! ;

	minRepairTime
	! return the minimum time it would take for each type and model !;
end



@ ******************    Kassidee: Damage       ********************
class Damage
! Manages the weather types !
#abstract
services
	cost 			! Returns the cost to repair the damage!;
	timeMultiplier  ! Returns the extra time multiplier for weather damage!;
end

class Pothole
! Contains the details for each mechanic. !
expands Damage
services
	size 			! Returns the size of the pothole!;
end

class WeatherDamage
! Contains info about specific types of damage caused by the elements. !
services
	weatherType 	! Returns the type of weather that cause the damage !;
end


@ ******************  Katrice: Mechanics ******************
@ - Cost per hour for each experience level.
@ Novice = $20 per hour.
@ Intermediate = $60 per hour.
@ Expert = $100 per hour.

class MechanicHourlyRate
! Determines the hourly rate of a mechanic based on their experience level. !

services
    getHourlyRate
    ! Returns 20 for novice, 60 for intermediate, and 100 for expert mechanics. !;

    calculateLabourCost
    ! Calculates the total labour cost by multiplying the hourly rate by 8 hours and the number of repair days. !;
end

@ - Minimum time to repair for each experience level.
@ Novice = 20 days.
@ Intermediate = 15 days.
@ Expert = 10 days.

class MechanicRepairTime
! Determines the minimum repair time based on the mechanic's experience level. !

services
    getMinimumRepairTime
    ! Returns 20 days for novice, 15 days for intermediate, and 10 days for expert mechanics. !;

    calculateRepairTime
    ! Determines the repair time by selecting the greater of the mechanic's minimum repair time and the vehicle's minimum repair time. !;
end

@ - Search the mechanics in listed order for the first available one.
! Searches mechanics in their listed order and assigns the first available mechanic to a vehicle. !

uses
    Mechanic with 1 to * label searches
    ! Searches the list of mechanics to locate the first available mechanic. !;
end

services
    findAvailableMechanic
    ! Searches the mechanics in their listed order and returns the first available mechanic. !;

    assignMechanic
    ! Assigns the selected mechanic to the vehicle and marks the mechanic as unavailable. !;

    releaseMechanic
    ! Marks the mechanic as available when the assigned vehicle has been repaired. !;
end

@ - The waiting list for where a vehicle goes when no mechanic is available,
@   and how it leaves when a mechanic becomes available.
class VehicleWaitingList
! Maintains a waiting list of vehicles that cannot be repaired immediately because all mechanics are busy. !

uses
    Vehicle with 0 to * label contains
    ! Contains vehicles waiting for an available mechanic. !;
end

services
    addVehicle
    ! Adds a vehicle to the waiting list when no mechanic is available. !;

    removeVehicle
    ! Removes the first vehicle from the waiting list when a mechanic becomes available. !;

    hasWaitingVehicles
    ! Checks whether there are any vehicles in the waiting list. !;

    getWaitingCount
    ! Returns the number of vehicles currently waiting for repair. !;

    assignWaitingVehicle
    ! Assigns the first waiting vehicle to a mechanic who has completed a repair. !;
end


@ ******************  Kalista: Jobs ************************
@ - The job record: vehicle type, name of the mechanic, total cost, time for completion.
class Job
! Represents a job repair record. !
services 
	vehicleType	! Returns the type of vehicle. !;
	mechanicName	! Returns the name of the mechanic. !;
	completionTime	! Returns the time it takes to complete a job. !;
	totalCost	! Returns the total cost of the job repair. !;
end
 
@ - The database of job records showing a job is created and stored before any repair is made.
class JobDatabase
! Stores the repair job records. !
uses
	Job with 0 to * label stores 	!Stores zero or more job records. !;
end

services
	storeJob		! Stores a job to the database. !;
end
@ - Total time which is essentially the mechanic's minimum time and the vehicle's minimum time,
@   plus if the damage was caused by the elements.
@ - Total cost, basically cost of the damage + cost of the mechanic + repair cost of the vehicle type
@   + cost of the parts for the vehicle type.
@ - Cost of the mechanic.
class RepairCalculations
! Calculates the time and costs for a vehicle repair. !
services
	totalTime		! Calculates the total time requires for the repair. !;
	mechanicCost		! Calculates the cost of the mechanic. !;
	calculatetotalCost	! Calculates the cost of the repair. !;


@ ******************  		  End 		   ************************
