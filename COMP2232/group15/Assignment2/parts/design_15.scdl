@ --------------------------------------------------------

class Simulation
! Contains the main method for running the simulation. !
uses
	Shop with 1 label simulates		! Simulates the shop. !;
end
#exclude

@ --------------------------------------------------------

class Shop
! Manages the shop. !
uses
	Mechanic with 1 to * label employs 	! Available mechanics. !;
	Vehicle with 0 to * label repairs	! Vehicles that need repair. !;
	Display with 1 label uses		! Displays the information. !;
	Menu with 1 label displays		! Manages the menu. !;
	MechanicAssignment with 1 label assigns		! Manages the assignment of mechanics. !;
	VehicleWaitingList with 1 label maintains	! Maintains vehicles waiting for a mechanic. !;
	JobDatabase with 1 label records			! Stores the repair job records. !;
	RepairCalculations with 1 label calculates	! Calculates repair costs and time. !;
end
services
	simulate				! Runs the simulation. !;
end
#exclude

@ --------------------------------------------------------

class Mechanic
! Contains the details for each mechanic. !
#exclude
services
	name 		! Name of the mechanic. !;
	id 		! The mechanic ID. !;
	experience 	! The experience level of the mechanic. !;
end
#exclude

@ --------------------------------------------------------

class Vehicle
! Contains information about specific types of vehicles. !
services
	company		! The company that manufactures the vehicle. !;
	type		! The type of vehicle such as car or van. !;
	model		! The model of the vehicle. !;
	damage		! The type of damage. !;
end
#exclude

@ --------------------------------------------------------

class Display
! Provides the functions needed for the display of information. !
services
	addJob						! Add a job. !;
	outputStatusTable			! Output the status table. !;
	outputSummary				! Output the summary. !;
	outputIterationNumber		! Output the iteration number. !;
	outputAddedToWaitingList	! Output the vehicle added to the waiting list message. !;
	outputAssignedToMechanic	! Output the vehicle assigned to a mechanic message. !;
	outputRepairedByMechanic	! Output the vehicle repaired by named mechanic message. !;
end
#exclude

@ --------------------------------------------------------

class Menu
! Displays and manages the menu. !
services
	displayMenu		! Displays the menu. !;
	getMenuSelection	! Gets the user's menu selection. !;
end
#exclude

@ ******************** Add your design below. ********************

@ ******************  Muhammad 1: Vehicles *******************

class VehicleRepairDetails
! Contains repair cost, parts cost, and minimum repair time information for different vehicle types and models. !
services 

	repairCost
	! Returns the calculated cost of repairing the giving vehicle. ! ;

	partCost
	! Returns the cost of parts for each type and model. ! ;

	minRepairTime
	! Return the minimum time it would take for each type and model !;
end

@ ******************    Kassidee: Damage       ********************
class Damage
! Manages any damage to a vehicle. !
#abstract
services
	cost 			! Returns the cost to repair the damage!;
	timeMultiplier  ! Returns the extra time multiplier for weather damage!;
end

class Pothole
! Contains the details for each pothole. !
expands Damage
services
	size 			! Returns the size of the pothole!;
end

class WeatherDamage
! Contains info about different types of damage caused by the elements. !
expands Damage
services
	weatherType 	! Returns the type of weather that cause the damage !;
end

class CollisionDamage
! Contains info about damage caused by an impact to one or more parts.  !
expands Damage
services
	parts			! Returns the damaged parts. !
end

@ ******************  Katrice: Mechanics ******************

class MechanicHourlyRate
! Determines the hourly rate of a mechanic based on their experience level. !

services
    getHourlyRate
    ! Returns 20 for novice, 60 for intermediate, and 100 for expert mechanics. !;

    calculateLabourCost
    ! Calculates the total labour cost by multiplying the hourly rate by 8 hours and the number of repair days. !;
end

class MechanicRepairTime
! Determines the minimum repair time based on the mechanic's experience level. !

services
    getMinimumRepairTime
    ! Returns 20 days for novice, 15 days for intermediate, and 10 days for expert mechanics. !;

    calculateRepairTime
    ! Determines the repair time by selecting the greater of the mechanic's minimum repair time and the vehicle's minimum repair time. !;
end

class MechanicAssignment
! Searches mechanics in their listed order and assigns the first available mechanic to a vehicle. !

uses
    Mechanic with 1 to * label searches
    ! Searches the list of mechanics to locate the first available mechanic. !;
end

services
    findAvailableMechanic
    ! Searches the mechanics in their listed order and returns the first available mechanic. !;

    assignMechanic
    ! Assigns the selected mechanic to the vehicle and marks the mechanic as unavailable. !;

    releaseMechanic
    ! Marks the mechanic as available when the assigned vehicle has been repaired. !;
end

class VehicleWaitingList
! Maintains a waiting list of vehicles that cannot be repaired immediately because all mechanics are busy. !

uses
    Vehicle with 0 to * label contains
    ! Contains vehicles waiting for an available mechanic. !;
end

services
    addVehicle
    ! Adds a vehicle to the waiting list when no mechanic is available. !;

    removeVehicle
    ! Removes the first vehicle from the waiting list when a mechanic becomes available. !;

    hasWaitingVehicles
    ! Checks whether there are any vehicles in the waiting list. !;

    getWaitingCount
    ! Returns the number of vehicles currently waiting for repair. !;

    assignWaitingVehicle
    ! Assigns the first waiting vehicle to a mechanic who has completed a repair. !;
end

@ ******************  Kalista: Jobs ************************
class Job
! Represents a job repair record. !
services 
	vehicleType	! Returns the type of vehicle. !;
	mechanicName	! Returns the name of the mechanic. !;
	completionTime	! Returns the time it takes to complete a job. !;
	totalCost	! Returns the total cost of the job repair. !;
end
 
class JobDatabase
! Stores the repair job records. !
uses
	Job with 0 to * label stores 	!Stores zero or more job records. !;
end

services
	storeJob		! Stores a job to the database. !;
end

class RepairCalculations
! Calculates the time and costs for a vehicle repair. !
uses
	Damage with 1 label uses				! Provides the damage cost and time multiplier for the repair. !;

	MechanicHourlyRate with 1 label uses	! Provides the mechanic's hourly rate. !;

    MechanicRepairTime with 1 label uses	! Provides the mechanic's minimum repair time. !;

    VehicleRepairDetails with 1 label uses	! Provides the vehicle repair cost, parts cost and minimum repair time. !;
end

services
	totalTime			! Calculates the total time required for the repair. !;
	mechanicCost		! Calculates the cost of the mechanic. !;
	calculateTotalCost	! Calculates the cost of the repair. !;
end

@ ******************  		  End 		   ************************
